# Use only 1 or 0 for boolean values.
AUTOPLAN_BOARD_PORT=4177
AUTOPLAN_FIXTURE_MODE=1
AUTOPLAN_REPO_PRIVATE=0

# HTTP broker write actions stay disabled unless this is explicitly set.
AUTOPLAN_ENABLE_HTTP_WRITE_ACTIONS=0

# Used by the refreshGithub broker action.
AUTOPLAN_GITHUB_REPO=metzgerwebsites/web-workflow-master

# screenshotAudit only accepts these hostnames and redacts sensitive query keys.
AUTOPLAN_SCREENSHOT_HOST_ALLOWLIST=127.0.0.1,localhost,::1,[::1]

# Telegram polling is disabled when TELEGRAM_POLL_INTERVAL_MS=0.
TELEGRAM_ALLOWED_USER_ID=replace-with-operator-id
TELEGRAM_BOT_TOKEN=never-commit-real-token
TELEGRAM_POLL_INTERVAL_MS=0
