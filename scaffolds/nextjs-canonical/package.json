    "stylelint-declaration-strict-value": "^1.11.1",
    "size-limit": "^12.1.0",
    "@size-limit/preset-app": "^12.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "size-limit": [
    {
      "path": "dist/**/*.js",
      "limit": "500 kB"
    }
  ],
  "engines": {
    "node": ">=22.0.0"
  }
}
