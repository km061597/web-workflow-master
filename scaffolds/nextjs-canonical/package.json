{
  "name": "nextjs-canonical",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lighthouse": "lhci autorun",
    "verify:setup": "node scripts/verify-setup.mjs",
    "verify:viewports": "node scripts/verify-viewports.mjs",
    "verify:a11y": "node scripts/verify-a11y.mjs",
    "quality": "npm run typecheck && npm run lint && npm run test && npm run build && npm run verify:a11y"
  },
  "dependencies": {
    "next": "16.2.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.8.2",
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.4",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.1.5",
    "@tailwindcss/postcss": "^4.1.5",
    "lucide-react": "^0.509.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.2.0",
    "zod": "^3.25.1",
    "react-hook-form": "^7.56.1",
    "@hookform/resolvers": "^5.2.2",
    "resend": "^6.12.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "motion": "^12.10.0",
    "gsap": "^3.13.0",
    "ai": "^2.0.0",
    "@ai-sdk/react": "^2.0.0",
    "openai": "^4.98.0",
