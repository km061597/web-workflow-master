{
  "name": "astro-canonical",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "audit": "node scripts/audit.mjs",
    "validate": "node scripts/validate.mjs",
    "check-links": "node scripts/check-links.mjs",
    "quality": "npm run typecheck && npm run lint && npm run build && npm run validate && npm run audit && npm run check-links && npm run test:e2e"
  },
  "dependencies": {
    "astro": "^6.2.2",
    "tailwindcss": "^4.2.4",
    "@tailwindcss/vite": "^4.2.4",
    "gsap": "^3.15.0",
    "@gsap/react": "^2.1.2",
    "lucide-react": "^0.509.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.0",
    "vite": "^7.3.2",
    "eslint": "^9.39.4",
    "astro-eslint-parser": "^1.4.0",
    "@eslint/js": "^9.39.4",
    "@typescript-eslint/parser": "^8.32.0",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-import": "^2.31.0",
    "prettier": "^3.8.3",
    "stylelint": "^17.10.0",
    "stylelint-config-standard": "^40.0.0",
    "playwright": "^1.59.1",
    "@playwright/test": "^1.59.1",
    "@axe-core/playwright": "^4.11.3",
    "lighthouse": "^13.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "globals": "^16.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
