---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Astro Canonical">
  <main class="flex min-h-screen flex-col items-center justify-center p-8">
    <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
      Astro Canonical
    </h1>
    <p class="mt-4 max-w-lg text-center text-lg text-muted-foreground">
      Production-ready Astro 6 scaffold with Tailwind 4, GSAP, and quality tooling.
    </p>
    <div class="mt-8 flex gap-4">
      <a href="/docs" class="inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90">
        Documentation
      </a>
    </div>
  </main>
</Layout>
